---
---

<section id="hero" class="hero-section">
  <div class="bg-glow" style="top: -10%; right: -10%;"></div>
  <div class="bg-glow" style="bottom: 10%; left: -5%; opacity: 0.5;"></div>
  
  <div class="container hero-wrapper">
    <div class="hero-content reveal">
      <span class="section-label">High-End Orthodontics</span>
      <h1 class="hero-title text-gradient">
        Qualität beginnt in der Produktion.
      </h1>
      <p class="hero-description">
        Wo genau werden Ihre Aligner hergestellt? Modern Clear bringt die Fertigung zurück nach Deutschland – für maximale Präzision und Ihre absolute Kontrolle.
      </p>

      <div class="hero-cta">
        <a href="#cta" class="btn-primary">Kostenfreie Planung testen</a>
        <a href="#vorteil" class="btn-secondary">Konzept entdecken</a>
      </div>
      
      <div class="hero-stats reveal delay-1">
        <div class="stat-item">
          <span class="stat-num">100%</span>
          <span class="stat-label">Made in Germany</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">24h</span>
          <span class="stat-label">Support</span>
        </div>
      </div>
    </div>
    
    <div class="hero-visual reveal delay-2">
      <div class="product-stage">
        <img src="/images/aligner.png" alt="Modern Clear Precision Aligner" class="hero-img" />
        <div class="glass-orb"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 180px;
    padding-bottom: 10rem;
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero-wrapper {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .hero-content {
    max-width: 680px;
  }

  .hero-title {
    font-size: clamp(3.5rem, 10vw, 5.5rem);
    margin-bottom: 2rem;
    line-height: 0.95;
  }

  .hero-description {
    font-size: 1.375rem;
    margin-bottom: 4rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 580px;
  }

  .hero-cta {
    display: flex;
    gap: 2rem;
    margin-bottom: 6rem;
  }

  .hero-stats {
    display: flex;
    gap: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .hero-visual {
    position: relative;
    z-index: 1;
  }

  .product-stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-img {
    width: 100%;
    height: auto;
    max-width: 600px;
    filter: drop-shadow(0 30px 60px rgba(0,0,0,0.1));
    z-index: 2;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .product-stage:hover .hero-img {
    transform: translateY(-20px) rotate(2deg);
  }

  .glass-orb {
    position: absolute;
    width: 120%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.05) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    z-index: 1;
  }

  @media (max-width: 1200px) {
    .hero-wrapper {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 8rem;
    }
    .hero-content {
      margin: 0 auto;
    }
    .hero-cta {
      justify-content: center;
    }
    .hero-stats {
      justify-content: center;
    }
    .hero-description {
       margin-left: auto;
       margin-right: auto;
    }
  }
</style>
