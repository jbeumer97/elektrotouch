---
const year = new Date().getFullYear();
---

<footer class="footer-lux section-padding">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/images/logo.png" alt="Modern Clear Logo" class="footer-logo" />
        <p class="brand-desc">
          Präzisions-Aligner für die moderne Fachpraxis. 100% Planung und Fertigung in Deutschland.
        </p>
      </div>

      <div class="footer-links">
        <div class="link-group">
          <h4>Navigation</h4>
          <a href="#prozess">Prozess</a>
          <a href="#vorteil">Vorteile</a>
          <a href="#zertifizierung">Zertifizierung</a>
          <a href="#cta">Planung testen</a>
        </div>
        
        <div class="link-group">
          <h4>Rechtliches</h4>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
          <a href="/agb">AGB</a>
        </div>
      </div>

      <div class="footer-contact">
        <h4>Kontakt</h4>
        <p>Modern Clear Lab GmbH</p>
        <p>Musterstraße 123</p>
        <p>10115 Berlin, Deutschland</p>
        <a href="mailto:hallo@modernclear.de" class="contact-link">hallo@modernclear.de</a>
        <a href="tel:+4900000000" class="contact-link">+49 (0) 30 000 00 00</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Modern Clear. Alle Rechte vorbehalten. Medical Class IIa Zertifiziert.</p>
    </div>
  </div>
</footer>

<style>
  .footer-lux {
    background: var(--color-bg-quartz);
    padding-top: 10rem;
    padding-bottom: 4rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1.5fr 1fr;
    gap: 6rem;
    margin-bottom: 8rem;
  }

  .footer-logo {
    height: 32px;
    width: auto;
    margin-bottom: 2rem;
  }

  .brand-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 320px;
    line-height: 1.6;
  }

  .footer-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .link-group h4, .footer-contact h4 {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: 2.5rem;
  }

  .link-group a, .footer-contact p, .contact-link {
    display: block;
    text-decoration: none;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    transition: color 0.3s ease;
  }

  .link-group a:hover, .contact-link:hover {
    color: var(--color-accent);
  }

  .contact-link {
    font-weight: 600;
    color: var(--color-primary);
  }

  .footer-bottom {
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 5rem;
    }
    .footer-links {
      gap: 2rem;
    }
  }
</style>
