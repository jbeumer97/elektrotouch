---
---

<section id="cta" class="section-padding relative overflow-hidden">
  <div class="bg-glow" style="top: 0; left: 0; opacity: 0.2;"></div>
  
  <div class="container relative">
    <div class="cta-lux-box reveal">
      <div class="cta-inner">
        <span class="section-label">Starten Sie jetzt</span>
        <h2 class="section-title">Bereit für den<br /><span class="text-gradient">nächsten Schritt?</span></h2>
        <p class="cta-lead">
          Testen Sie die Präzision von Modern Clear völlig unverbindlich. Laden Sie Ihren ersten Fall hoch und erhalten Sie eine kostenfreie digitale Planung.
        </p>
        
        <form id="cta-form" class="cta-lux-form">
          <div class="form-row">
            <div class="input-group">
              <input type="text" placeholder="Name der Praxis" required />
            </div>
            <div class="input-group">
              <input type="email" placeholder="E-Mail Adresse" required />
            </div>
          </div>
          <button type="submit" class="btn-primary">Kostenfreie Planung testen</button>
        </form>
        
        <div class="cta-benefits">
          <span>✓ 100% Kostenfrei</span>
          <span>✓ Ohne Bindung</span>
          <span>✓ Direkter Kontakt</span>
        </div>
      </div>
    </div>
    
    <div class="secondary-cta reveal delay-2">
      <p>Sie haben noch Fragen? Wir beraten Sie persönlich.</p>
      <a href="tel:+4900000000" class="btn-secondary">Termin vereinbaren</a>
    </div>
  </div>
</section>

<style>
  .cta-lux-box {
    background: white;
    padding: 6rem;
    border-radius: var(--radius-lux);
    box-shadow: var(--shadow-lux);
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .cta-lux-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--color-accent), #3b82f6);
  }

  .cta-lead {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto 4rem;
    line-height: 1.6;
  }

  .cta-lux-form {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .cta-lux-form input {
    background: var(--color-bg-quartz);
    border: 1px solid var(--color-border);
    padding: 1.25rem 1.5rem;
    border-radius: 100px;
    color: var(--color-primary);
    font-size: 1rem;
    width: 100%;
    transition: all 0.3s ease;
  }

  .cta-lux-form input:focus {
    outline: none;
    border-color: var(--color-accent);
    background: white;
    box-shadow: 0 0 0 4px var(--color-accent-glow);
  }

  .cta-benefits {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-top: 4rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .secondary-cta {
    margin-top: 5rem;
    text-align: center;
  }

  .secondary-cta p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .cta-lux-box {
      padding: 3rem 1.5rem;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .cta-benefits {
      flex-direction: column;
      gap: 1.5rem;
    }
  }
</style>
