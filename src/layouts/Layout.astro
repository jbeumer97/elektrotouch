---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Modern Clear – High-End Aligner Produktion aus Deutschland. Maximale Präzision und Kontrolle für Fachpraxen.' } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <title>{title}</title>

    <!-- JSON-LD Medical Business Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "MedicalBusiness",
        "name": "Modern Clear Lab GmbH",
        "telephone": "+49 30 000 00 00",
        "email": "hallo@modernclear.de",
        "url": "https://modernclear.de",
        "description": "Premium Aligner Produktion Made in Germany.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Musterstraße 123",
          "addressLocality": "Berlin",
          "postalCode": "10115",
          "addressCountry": "DE"
        }
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
